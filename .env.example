# ---- App ----
APP_URL=http://localhost:3000
API_URL=http://localhost:8787
NODE_ENV=development

# ---- Auth (session JWT) ----
# REQUIRED in production: >= 32 chars, e.g. `openssl rand -hex 32`.
# The app refuses to boot in production with the insecure dev default.
AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# ---- Secrets at rest ----
# AES-256-GCM key for encrypting DKIM private keys + connected-account OAuth
# tokens in the DB (NFR-004). 64 hex chars = 32 bytes, e.g. `openssl rand -hex 32`.
# No default — encrypt/decrypt fail closed if unset.
DKIM_ENC_KEY=

# ---- Database (control plane) ----
DATABASE_URL=postgresql://ems:ems@localhost:5432/ems?schema=public

# ---- Queue / cache store ----
# (legacy alias REDIS_URL is still honored)
QUEUE_URL=redis://localhost:6379

# ---- Sending relay (own MTA, no third-party cloud sender) ----
# Points the worker at the self-hosted relay. Unset → stub mode (the pipeline
# stays testable without real delivery).
SMTP_URL=smtp://ems-mta:25
# Public IPv4 the MTA sends from (God Mode reputation). Live hub is .223.
# SENDING_IP=31.220.104.223
# MAIL_BOUNCE_DOMAIN=bounce.electronicmailservices.com

# Platform-owned domains anyone can claim an inbox on with no DNS of their own
# (POST /inboxes). Comma-separated; the FIRST is the default. Serves both agent
# inboxes (agents.*) and the no-Workspace human/company mode (inbox.*) — see
# planning/INBOX_MODES.md. Sending works once the box's DKIM/SPF cover the
# domain; receiving once its MX points at the mailbox MTA (/mta/mailbox-domains
# then picks it up). Legacy alias AGENT_INBOX_DOMAIN is still honoured.
# SHARED_INBOX_DOMAINS=agents.electronicmailservices.com,inbox.electronicmailservices.com
# Kill switch for pooled shared-domain create/send. "off" refuses customer use
# (platform internal mail still allowed). Reputation on a shared domain is
# everyone-or-no-one.
# SHARED_INBOX_SENDING=on
# MAIL_RELAY_STUB=true          # force stub even when SMTP_URL is set (legacy: SES_STUB)
# MAIL_RELAY_REGION=primary     # internal region label (legacy: AWS_REGION)
# MAIL_RELAY_CONFIG_SET=        # optional named config set for event tracking (legacy: SES_CONFIGURATION_SET)

# ---- God Mode (platform super-admin) ----
# The email auto-promoted to superadmin on first login — ONLY when no superadmin
# exists yet (bootstrap), and only after that address verifies. Claim it promptly.
GOD_SUPERADMIN_EMAIL=

# ---- Managed DNS (one-click publishing + propagation monitor) ----
# Token needs Zone:Read (to find the zone) + DNS:Edit (to write records).
# Enables one-click DNS publishing for zones this token covers; manual
# copy-paste + auto-verification always work without it.
# (legacy alias CLOUDFLARE_API_TOKEN is still honored)
DNS_API_TOKEN=

# ---- Connected-account sending (send from a client's own Gmail / Outlook) ----
# OAuth app credentials for the "Connect mailbox" flow. Optional — connected
# sending is unavailable until set. Redirect URIs point back at the API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/connect/google/callback
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT=common
MS_OAUTH_REDIRECT_URI=http://localhost:8787/connect/microsoft/callback

# ---- Observability (Better Stack heartbeats — optional) ----
# Unique GET URLs from Uptime → Heartbeats. Unset = no-op.
# BETTERSTACK_HEARTBEAT_WORKERS=
# BETTERSTACK_HEARTBEAT_MAILLOG=
# See infra/observability.md for the 10 monitors to paste.

# ---- Analytics event store (Phase 1d) ----
ANALYTICS_TOKEN=
ANALYTICS_URL=

# ---- Object storage (S3-compatible) ----
STORAGE_ACCOUNT_ID=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=ems-assets

# ─────────────────────────────────────────────────────────────────────────────
# EMS — cold outreach
# ─────────────────────────────────────────────────────────────────────────────

# Local stack (infra/docker-compose.yml). High host ports on purpose: this
# machine also runs a system Postgres/Redis and the usermails stack.
DATABASE_URL="postgresql://ems:ems@127.0.0.1:55432/ems"
REDIS_URL="redis://127.0.0.1:56379"

# Observation store. Postgres holds decisions; ClickHouse holds what happened.
CLICKHOUSE_URL="http://127.0.0.1:8123"
CLICKHOUSE_DB="ems"
CLICKHOUSE_USER="ems"
CLICKHOUSE_PASSWORD="ems"

# Local SMTP sink. Dev never sends real mail unless this is explicitly unset
# AND EMS_ALLOW_REAL_SEND=1.
SMTP_URL="smtp://127.0.0.1:1025"
EMS_ALLOW_REAL_SEND="0"

# Inference — the single sanctioned AI dependency (planning/AI.md).
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_MONTHLY_CEILING_USD="250"

# Fleet control plane. The agent signs every report; the API refuses unsigned.
EMS_AGENT_SIGNING_KEY=""
EMS_NODE_ALLOWLIST=""

# Registrar + DNS seams (packages/registrar).
CLOUDFLARE_DNS_TOKEN=""
REGISTRAR_PROVIDER="cloudflare"
REGISTRAR_API_KEY=""

# The dedicated domain that receives every sending domain's DMARC rua/ruf and
# TLS-RPT, so report traffic stays off the sending domains.
AGGREGATE_REPORT_DOMAIN=""

# Verification runs from its own IP that never sends campaigns (E12-017).
VERIFY_NODE_URL=""

# Seed accounts for placement probing. Read only by apps/seedbox; this key must
# not exist on any host that also sends campaigns (E21-094).
SEEDBOX_CREDENTIAL_KEY=""

# Handoff target: the moment a lead opts in, they leave EMS.
HANDOFF_TARGET_URL=""
HANDOFF_API_KEY=""

# Billing seam (packages/billing). Stripe is isolated behind BillingProvider.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
