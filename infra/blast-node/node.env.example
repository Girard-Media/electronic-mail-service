# blast-node identity — copy to node.env and fill in before provisioning.

# Public address and its PTR. Both must forward-confirm (invariant I2).
NODE_IP=203.0.113.10
NODE_HOSTNAME=mta01.example-sending-domain.com

# Sending domains this node is authorised to relay for, space separated.
# Anything not in this list is rejected at smtpd.
ALLOWED_SENDER_DOMAINS="example-sending-domain.com bounce.example-sending-domain.com"

# The ONLY host permitted to submit mail, besides loopback: the workers' private IP.
WORKERS_PRIVATE_IP=10.10.0.5

# Where the aggregate-report domain lives (rua/ruf/tlsrpt targets).
AGGREGATE_DOMAIN=ems-reports.example.com

# Control plane the fleet-agent reports to.
EMS_API_URL=https://app.electronicmailservices.com
EMS_NODE_ID=
EMS_AGENT_SIGNING_KEY=

# Operator SSH allowlist (CIDR, space separated) and SSH port.
SSH_ALLOWLIST="203.0.113.200/32"
SSH_PORT=22022

# Let's Encrypt registration address.
ACME_EMAIL=ops@girardmedia.com
