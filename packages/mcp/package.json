  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ems/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0"
  }
}
