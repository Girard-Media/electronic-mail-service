{
  "name": "ems-migrate",
  "version": "0.1.0",
  "description": "Migrate to ems from ESPs and outreach platforms — pull domains, templates, contacts, campaigns, lead lists, mailboxes, and suppressions so switching is seamless.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "ems-migrate": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs"
  },
  "//publishConfig": "src exports are for in-repo TS resolution; npm publish swaps to the built dist.",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "email",
    "migration",
    "resend",
    "ems",
    "esp",
    "outreach",
    "cold-email"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
