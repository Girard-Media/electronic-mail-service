{
  "name": "ems-migrate",
  "version": "0.1.0",
  "description": "Migrate to ems from Resend (and other ESPs) — pull domains, templates, and contacts so switching is seamless.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "ems-migrate": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "//publishConfig": "src exports are for in-repo TS resolution; npm publish swaps to the built dist.",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": ["email", "migration", "resend", "ems", "esp"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
