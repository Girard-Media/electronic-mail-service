{
  "name": "@ems/dmarc-ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Receives DMARC RUA aggregate XML and TLS-RPT JSON on the aggregate-report domain",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs"
  },
  "dependencies": {
    "@ems/core": "workspace:*",
    "@ems/db": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0"
  }
}
